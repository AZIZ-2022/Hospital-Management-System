@model WebApplicationDocLab.Models.Prescription

@{
    ViewBag.Title = "Prescriptions";
    Layout = "~/Views/_LayoutPagePatient.cshtml";
}

<div class="container mt-4">
    <div class="card">
        <div class="card-header bg-primary text-white">
            <h4>Most Recent Prescription</h4>
        </div>
        <div class="card-body">
            @if (ViewBag.RecentPrescription != null)
            {
                var doctor = ViewBag.RecentPrescriptionDoctor as WebApplicationDocLab.Models.User_Info;
                <div>
                    <h5>
                        Doctor:
                        @(doctor != null ? $"{doctor.FirstName} {doctor.LastName}" : "N/A")
                    </h5>
                    <p><strong>Prescription Date:</strong> @ViewBag.RecentPrescription.PrescriptionDate.ToShortDateString()</p>
                    <p><strong>Notes:</strong> @ViewBag.RecentPrescription.Notes</p>
                    <p><strong>Medicines:</strong></p>
                    @if (ViewBag.RecentPrescription.Medicine_Lists != null && ViewBag.RecentPrescription.Medicine_Lists.Count > 0)
                    {
                        <ul>
                            @foreach (var med in ViewBag.RecentPrescription.Medicine_Lists)
                            {
                                <li>@(med.Medicine != null ? med.Medicine.MedicineName : "Unknown") (@med.Dosage, @med.Duration)</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p>No medicines assigned.</p>
                    }
                </div>
            }
            else
            {
                <p>No prescriptions found.</p>
            }
        </div>
    </div>
</div>
