@model IEnumerable<WebApplicationDocLab.Models.Prescription>
@{
    ViewBag.Title = "PreviousPrescriptions";
    Layout = "~/Views/_LayoutPagePatient.cshtml";
}


<div class="container mt-4">
    <div class="card">
        <div class="card-header bg-primary text-white">
            <h4>Previous Prescriptions</h4>
        </div>
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                foreach (var prescription in Model)
                {
                    WebApplicationDocLab.Models.User_Info doctor = null;
                    (ViewBag.Doctors as Dictionary<int, WebApplicationDocLab.Models.User_Info>)?.TryGetValue(prescription.DoctorId, out doctor);
                    <div class="mb-3">
                        <p><strong>Medicines:</strong></p>
                        @if (prescription.Medicine_Lists != null && prescription.Medicine_Lists.Any())
                        {
                            <ul>
                                @foreach (var med in prescription.Medicine_Lists)
                                {
                                    <li>@(med.Medicine != null ? med.Medicine.MedicineName : "Unknown") (@med.Dosage, @med.Duration)</li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p>No medicines assigned.</p>
                        }
                        <p><strong>Prescription Date:</strong> @prescription.PrescriptionDate.ToShortDateString()</p>
                        <p>
                            <strong>Doctor:</strong> @(doctor != null ? doctor.FirstName + " " + doctor.LastName : "No Doctor Assigned")
                        </p>
                        <hr />
                    </div>
                }
            }
            else
            {
                <p>No previous prescriptions found.</p>
            }
        </div>
    </div>
</div>
