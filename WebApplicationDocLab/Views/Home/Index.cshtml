                    <div class="stats-item">
                        <span data-purecounter-start="0" data-purecounter-end="150" data-purecounter-duration="1" class="purecounter"></span>
                        <p>Awards</p>
                    </div>
                </div><!-- End Stats Item -->

            </div>

        </div>

    </section><!-- /Stats Section -->
    <!-- Services Section -->
    <section id="services" class="services section">

        <!-- Section Title -->
        <div class="container section-title" data-aos="fade-up">
            <h2>Services</h2>
            <p>Comprehensive medical care delivered by experienced specialists across every department</p>
        </div><!-- End Section Title -->

        <div class="container">

            <div class="row gy-4">

                <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="100">
                    <div class="service-item  position-relative">
                        <div class="icon">
                            <i class="fas fa-heartbeat"></i>
                        </div>
                        <a href="#" class="stretched-link">
                            <h3>Cardiology</h3>
                        </a>
                        <p>Comprehensive heart care from diagnosis to treatment, led by experienced cardiologists.</p>
                    </div>
                </div><!-- End Service Item -->

                <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="200">
                    <div class="service-item position-relative">
                        <div class="icon">
                            <i class="fas fa-pills"></i>
                        </div>
                        <a href="#" class="stretched-link">
                            <h3>Pharmacy</h3>
                        </a>
                        <p>A fully stocked in-house pharmacy so patients can get prescribed medicine right after their visit.</p>
                    </div>
                </div><!-- End Service Item -->

                <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="300">
                    <div class="service-item position-relative">
                        <div class="icon">
                            <i class="fas fa-hospital-user"></i>
                        </div>
                        <a href="#" class="stretched-link">
                            <h3>Patient Care</h3>
                        </a>
                        <p>Attentive, round-the-clock nursing and support staff dedicated to patient comfort and recovery.</p>
                    </div>
                </div><!-- End Service Item -->

                <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="400">
                    <div class="service-item position-relative">
                        <div class="icon">
                            <i class="fas fa-dna"></i>
                        </div>
                        <a href="#" class="stretched-link">
                            <h3>Diagnostics &amp; Lab Testing</h3>
                        </a>
                        <p>Modern lab facilities providing fast, accurate test results to support every diagnosis.</p>
                        <a href="#" class="stretched-link"></a>
                    </div>
                </div><!-- End Service Item -->

                <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="500">
                    <div class="service-item position-relative">
                        <div class="icon">
                            <i class="fas fa-wheelchair"></i>
                        </div>
                        <a href="#" class="stretched-link">
                            <h3>Physical Therapy</h3>
                        </a>
                        <p>Personalized rehabilitation programs to help patients recover mobility and strength.</p>
                        <a href="#" class="stretched-link"></a>
                    </div>
                </div><!-- End Service Item -->

                <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="600">
                    <div class="service-item position-relative">
                        <div class="icon">
                            <i class="fas fa-notes-medical"></i>
                        </div>
                        <a href="#" class="stretched-link">
                            <h3>Medical Records</h3>
                        </a>
                        <p>Secure, organized digital records that keep every patient's history accurate and accessible.</p>
                        <a href="#" class="stretched-link"></a>
                    </div>
                </div><!-- End Service Item -->

            </div>

        </div>

    </section><!-- /Services Section -->
    <!-- Appointment Section -->
    <section id="appointment" class="appointment section">

        <!-- Section Title -->
        <div class="container section-title" data-aos="fade-up">
            <h2>Appointment</h2>
            <p>Book your visit in a few simple steps and we'll confirm it as soon as possible</p>
        </div><!-- End Section Title -->

        <div class="container" data-aos="fade-up" data-aos-delay="100">

            <form action="~/forms/appointment.php" method="post" role="form" class="php-email-form">
                <div class="row">
                    <div class="col-md-4 form-group">
                        <input type="text" name="name" class="form-control" id="name" placeholder="Your Name" required="">
                    </div>
                    <div class="col-md-4 form-group mt-3 mt-md-0">
                        <input type="email" class="form-control" name="email" id="email" placeholder="Your Email" required="">
                    </div>
                    <div class="col-md-4 form-group mt-3 mt-md-0">
                        <input type="tel" class="form-control" name="phone" id="phone" placeholder="Your Phone" required="">
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4 form-group mt-3">
                        <input type="datetime-local" name="date" class="form-control datepicker" id="date" placeholder="Appointment Date" required="">
                    </div>
                    <div class="col-md-4 form-group mt-3">
                        <select name="department" id="department" class="form-select" required="">
                            <option value="">Select Department</option>
                            <option value="Department 1">Department 1</option>
                            <option value="Department 2">Department 2</option>
                            <option value="Department 3">Department 3</option>
                        </select>
                    </div>
                    <div class="col-md-4 form-group mt-3">
                        <select name="doctor" id="doctor" class="form-select" required="">
                            <option value="">Select Doctor</option>
                            <option value="Doctor 1">Doctor 1</option>
                            <option value="Doctor 2">Doctor 2</option>
                            <option value="Doctor 3">Doctor 3</option>
                        </select>
                    </div>
                </div>

                <div class="form-group mt-3">
                    <textarea class="form-control" name="message" rows="5" placeholder="Message (Optional)"></textarea>
                </div>
                <div class="mt-3">
                    <div class="loading">Loading</div>
                    <div class="error-message"></div>
                    <div class="sent-message">Your appointment request has been sent successfully. Thank you!</div>
                    <div class="text-center"><button type="submit">Make an Appointment</button></div>
                </div>
            </form>

        </div>

    </section><!-- /Appointment Section -->
    <!-- Departments Section -->
    <section id="departments" class="departments section">

        <!-- Section Title -->
        <div class="container section-title" data-aos="fade-up">
            <h2>Departments</h2>
            <p>Specialized care teams covering the full range of medical needs under one roof</p>
        </div><!-- End Section Title -->

        <div class="container" data-aos="fade-up" data-aos-delay="100">

            <div class="row">
                <div class="col-lg-3">
                    <ul class="nav nav-tabs flex-column">
                        <li class="nav-item">
                            <a class="nav-link active show" data-bs-toggle="tab" href="#departments-tab-1">Cardiology</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" data-bs-toggle="tab" href="#departments-tab-2">Neurology</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" data-bs-toggle="tab" href="#departments-tab-3">Hepatology</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" data-bs-toggle="tab" href="#departments-tab-4">Pediatrics</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" data-bs-toggle="tab" href="#departments-tab-5">Eye Care</a>
                        </li>
                    </ul>
                </div>
                <div class="col-lg-9 mt-4 mt-lg-0">
                    <div class="tab-content">
                        <div class="tab-pane active show" id="departments-tab-1">
                            <div class="row">
                                <div class="col-lg-8 details order-2 order-lg-1">
                                    <h3>Cardiology</h3>
                                    <p class="fst-italic">Expert heart care from routine checkups to advanced cardiac treatment</p>
                                    <p>Our cardiology team diagnoses and treats conditions affecting the heart and blood vessels, from hypertension and arrhythmia to more complex cardiovascular disease, using modern diagnostic equipment and a patient-first approach.</p>
                                </div>
                                <div class="col-lg-4 text-center order-1 order-lg-2">
                                    <img src="~/assets/img/departments-1.jpg" alt="" class="img-fluid">
                                </div>
                            </div>
                        </div>
                        <div class="tab-pane" id="departments-tab-2">
                            <div class="row">
                                <div class="col-lg-8 details order-2 order-lg-1">
                                    <h3>Neurology</h3>
                                    <p class="fst-italic">Specialized diagnosis and treatment for conditions of the brain and nervous system</p>
                                    <p>Our neurology department treats a wide range of conditions, including migraines, epilepsy, stroke, and nerve disorders, combining advanced imaging with experienced specialists to deliver precise, effective care.</p>
                                </div>
                                <div class="col-lg-4 text-center order-1 order-lg-2">
                                    <img src="~/assets/img/departments-2.jpg" alt="" class="img-fluid">
                                </div>
                            </div>
                        </div>
                        <div class="tab-pane" id="departments-tab-3">
                            <div class="row">
                                <div class="col-lg-8 details order-2 order-lg-1">
                                    <h3>Hepatology</h3>
                                    <p class="fst-italic">Dedicated care for the liver, gallbladder, and digestive system</p>
                                    <p>Our hepatology specialists diagnose and manage liver conditions such as hepatitis, fatty liver disease, and cirrhosis, offering long-term care plans tailored to each patient's needs.</p>
                                </div>
                                <div class="col-lg-4 text-center order-1 order-lg-2">
                                    <img src="~/assets/img/departments-3.jpg" alt="" class="img-fluid">
                                </div>
                            </div>
                        </div>
                        <div class="tab-pane" id="departments-tab-4">
                            <div class="row">
                                <div class="col-lg-8 details order-2 order-lg-1">
                                    <h3>Pediatrics</h3>
                                    <p class="fst-italic">Gentle, friendly care for infants, children, and teenagers</p>
                                    <p>Our pediatric team handles everything from routine check-ups and vaccinations to the diagnosis and treatment of childhood illnesses, in a comfortable environment designed with young patients in mind.</p>
                                </div>
                                <div class="col-lg-4 text-center order-1 order-lg-2">
                                    <img src="~/assets/img/departments-4.jpg" alt="" class="img-fluid">
                                </div>
                            </div>
                        </div>
                        <div class="tab-pane" id="departments-tab-5">
                            <div class="row">
                                <div class="col-lg-8 details order-2 order-lg-1">
                                    <h3>Eye Care</h3>
                                    <p class="fst-italic">Complete vision care, from routine exams to advanced eye treatment</p>
                                    <p>Our ophthalmology team provides eye exams, treatment for common conditions like cataracts and glaucoma, and guidance on corrective lenses, helping patients protect and maintain healthy vision.</p>
                                </div>
                                <div class="col-lg-4 text-center order-1 order-lg-2">
                                    <img src="~/assets/img/departments-5.jpg" alt="" class="img-fluid">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>

    </section><!-- /Departments Section -->
    <section id="doctors" class="doctors section">
        <div class="container section-title" data-aos="fade-up">
            <h2>Doctors</h2>
            <p>Meet our medical experts</p>
        </div>

        <div class="container">
            <div class="row gy-4">
                @{
                    var doctors = Model.Where(x => x.UserType == "Doctor").ToList();
                }

                @for (int i = 0; i < doctors.Count; i++)
                {
                    var doctor = doctors[i];
                    <div class="col-lg-6 @(i > 1 ? "more-doctors" : "")" style="@(i > 1 ? "display:none;" : "")" data-aos="fade-up" data-aos-delay="100">
                        <div class="team-member d-flex align-items-start">
                            <div class="pic">
                                <img src="@Url.Content("~/image/DoctorImage/" + doctor.Image)" class="img-fluid" alt="@doctor.FirstName @doctor.LastName" />
                            </div>

                            <div class="member-info">
                                <h4>@doctor.Title @doctor.FirstName @doctor.LastName</h4>
                                <span>@doctor.DocType</span>
                                <p>@doctor.Department</p>
                                <p><strong>Phone:</strong> @doctor.Phone</p>
                                <div class="social">
                                    <a href=""><i class="bi bi-twitter-x"></i></a>
                                    <a href=""><i class="bi bi-facebook"></i></a>
                                    <a href=""><i class="bi bi-instagram"></i></a>
                                    <a href=""> <i class="bi bi-linkedin"></i> </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (doctors.Count > 2)
            {
                <div class="text-center mt-3">
                    <button id="seeMoreBtn" class="btn btn-primary">See More</button>
                </div>
            }
        </div>
    </section>

    <script>
        document.getElementById('seeMoreBtn')?.addEventListener('click', function () {
            document.querySelectorAll('.more-doctors').forEach(el => el.style.display = 'block');
            this.style.display = 'none';
        });
    </script>
    <!-- Faq Section -->
    <section id="faq" class="faq section light-background">

        <!-- Section Title -->
        <div class="container section-title" data-aos="fade-up">
            <h2>Frequently Asked Questions</h2>
            <p>Answers to the questions patients ask us most often</p>
        </div><!-- End Section Title -->

        <div class="container">

            <div class="row justify-content-center">

                <div class="col-lg-10" data-aos="fade-up" data-aos-delay="100">

                    <div class="faq-container">

                        <div class="faq-item faq-active">
                            <h3>How do I book an appointment?</h3>
                            <div class="faq-content">
                                <p>Create a patient account, log in, and go to "Book New Appointment" from your dashboard. Choose a doctor, pick an available date and time slot, and confirm your booking in a few clicks.</p>
                            </div>
                            <i class="faq-toggle bi bi-chevron-right"></i>
                        </div><!-- End Faq item-->

                        <div class="faq-item">
                            <h3>Can I view my prescriptions and medical history online?</h3>
                            <div class="faq-content">
                                <p>Yes. Once you log in to your patient dashboard, you can view your most recent prescription, your full prescription history, past visits, and any medical records your doctor has added.</p>
                            </div>
                            <i class="faq-toggle bi bi-chevron-right"></i>
                        </div><!-- End Faq item-->

                        <div class="faq-item">
                            <h3>What should I do if I need to cancel or reschedule?</h3>
                            <div class="faq-content">
                                <p>Go to "My Appointments" on your patient dashboard, find the booking you want to change, and cancel it there. You can then book a new appointment with your preferred date, time, and doctor.</p>
                            </div>
                            <i class="faq-toggle bi bi-chevron-right"></i>
                        </div><!-- End Faq item-->

                        <div class="faq-item">
                            <h3>How do I pay for an appointment?</h3>
                            <div class="faq-content">
                                <p>After booking, you'll be taken to a payment page where you can pay by cash (for in-person visits) or online using Card, bKash, Rocket, Nagad, or online banking, depending on the booking type.</p>
                            </div>
                            <i class="faq-toggle bi bi-chevron-right"></i>
                        </div><!-- End Faq item-->

                        <div class="faq-item">
                            <h3>Can doctors message patients directly?</h3>
                            <div class="faq-content">
                                <p>Yes. Doctors and patients who have an appointment together can chat directly within the platform to discuss follow-up questions or care instructions.</p>
                            </div>
                            <i class="faq-toggle bi bi-chevron-right"></i>
                        </div><!-- End Faq item-->

                        <div class="faq-item">
                            <h3>Is my personal and medical information kept private?</h3>
                            <div class="faq-content">
                                <p>Yes. Your account is protected by a login and password, and your medical records are only accessible to you, your doctor, and authorized administrators.</p>
                            </div>
                            <i class="faq-toggle bi bi-chevron-right"></i>
                        </div><!-- End Faq item-->

                    </div>

                </div><!-- End Faq Column-->

            </div>

        </div>

    </section><!-- /Faq Section -->
    <!-- Testimonials Section -->
